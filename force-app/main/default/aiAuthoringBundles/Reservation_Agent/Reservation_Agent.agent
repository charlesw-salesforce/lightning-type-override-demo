system:
   instructions: "You are an AI agent that helps customers manage reservations and find restaurants."
   messages:
       welcome: "Hi, I'm the Reservation Agent. How can I help you?"
       error: "Sorry, it looks like something has gone wrong."

config:
 developer_name: "Reservation_Agent"
 agent_label: "Reservation Agent"
 agent_type: "AgentforceEmployeeAgent"
 description: "Reservation Agent description"

variables:
   reservation_submitted: mutable boolean = False
   reservation_details: mutable object = None

language:
   default_locale: "en_US"
   additional_locales: ""
   all_additional_locales: False

start_agent topic_selector:
   label: "Topic Selector"
   description: "Welcome the user and determine the appropriate topic based on user input"

   reasoning:
       instructions: ->
           | Select the tool that best matches the user's message and conversation history. If it's unclear, make your best guess.
       actions:
           go_to_book_reservation: @utils.transition to @topic.reservation_management
               description: "Route to reservation booking. Call for reservation-related requests and ACTION_CONFIRM messages."
           go_to_restaurant_search: @utils.transition to @topic.restaurant_search
               description: "Route to restaurant search. Call when user wants to find or search for restaurants or storefronts."

topic reservation_management:
    label: "Reservation Management"

    description: "Handles request from users who want to book a reservation."

    reasoning:
        instructions: ->
            if not @variables.reservation_submitted:
                | If ACTION_CONFIRM, call {!@actions.Book_Reservation} with the form data. Do NOT ask for confirmation or output any text.
            else:
                | Reservation booked. Call show_command to display the Book_Reservation result output. Do NOT output any text.

        actions:
            Book_Reservation: @actions.Book_Reservation
                available when @variables.reservation_submitted == False
                with request = ...
                set @variables.reservation_submitted = True
                set @variables.reservation_details = @outputs.result



    actions:
        Book_Reservation:
          description: "Use this action to book a reservation."
          inputs:
            request: object
              description: "The reservation details."
              label: "request"
              is_required: True
              is_user_input: True
              complex_data_type_name: "c__reservationEditor"
          outputs:
            result: object
              description: "The reservation confirmation details."
              label: "result"
              complex_data_type_name: "c__reservationRenderer"
              filter_from_agent: False
              is_displayable: True
          target: "apex://BookReservationAction"
          label: "Book Reservation"
          require_user_confirmation: False
          include_in_progress_indicator: True
          progress_indicator_message: "Booking ..."
          source: "Book_Reservation"

topic restaurant_search:
    label: "Restaurant Search"

    description: "Handles requests from users who want to search for restaurants or storefronts by name."

    reasoning:
        instructions: ->
            | Ask the user what restaurant or storefront they are looking for.
            | Once you have a name or partial name, call {!@actions.Get_Storefronts_By_Name} with the search term.
            | After results are returned, display them to the user. Do NOT summarize the results in text.

        actions:
            Get_Storefronts_By_Name: @actions.Get_Storefronts_By_Name
                with storefrontName = ...

    actions:
        Get_Storefronts_By_Name:
          description: "Search for storefronts by name. Returns a list of matching storefronts displayed as a carousel."
          inputs:
            storefrontName: string
              description: "The storefront name (or partial name) to search for."
              label: "Storefront Name"
              is_required: True
              is_user_input: True
          outputs:
            storefronts: list[object]
              description: "List of matching storefronts."
              label: "Storefronts"
              complex_data_type_name: "@apexClassType/c__AgentStorefrontActions$StorefrontSummary"
              filter_from_agent: False
              is_displayable: True
            success: boolean
              description: "True if successful."
              label: "Success"
              filter_from_agent: True
              is_displayable: False
            message: string
              description: "User-readable status message."
              label: "Message"
              filter_from_agent: True
              is_displayable: False
          target: "apex://AgentStorefrontActions"
          label: "Get Storefronts By Name"
          require_user_confirmation: False
          include_in_progress_indicator: True
          progress_indicator_message: "Searching ..."
          source: "Get_Storefronts_By_Name"
